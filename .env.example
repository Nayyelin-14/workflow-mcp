DATABASE_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/<db_name>?maxPoolSize=50

KINDE_CLIENT_ID=your_kinde_client_id
KINDE_CLIENT_SECRET=your_kinde_client_secret
KINDE_ISSUER_URL=https://<your-kind>.kinde.com
KINDE_SITE_URL=http://localhost:3000
KINDE_POST_LOGOUT_REDIRECT_URL=http://localhost:3000/
KINDE_POST_LOGIN_REDIRECT_URL=http://localhost:3000/workflow

UPSTASH_REDIS_REST_URL=https://<your-region>.upstash.io/...
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

OPENROUTER_API_KEY=your_openrouter_api_key

# QStash — local dev uses Upstash's built-in dev server (auto-downloaded on first use).
# Set QSTASH_DEV=true for local development, remove/unset for production.
QSTASH_DEV=true
QSTASH_TOKEN=your_qstash_token
QSTASH_BASE_URL=https://<your-region>.qstash.io/...
QSTASH_CURRENT_SIGNING_KEY=your_qstash_current_signing_key
QSTASH_NEXT_SIGNING_KEY=your_qstash_next_signing_key

# Auto-injected by Vercel when "Protection Bypass for Automation" is enabled.
VERCEL_AUTOMATION_BYPASS_SECRET=your_vercel_bypass_secret
