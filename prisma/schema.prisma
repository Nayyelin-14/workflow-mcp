generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mongodb"
}

model Workflow {
  id  String @id @default(auto()) @map("_id") @db.ObjectId
  userId String
  name String
  description String
  flowObject String @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
